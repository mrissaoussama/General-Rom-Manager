<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!--If you are willing to use Windows/MacOS native APIs you will need to create 3 projects.
    One for Windows with net10.0-windows TFM, one for MacOS with net10.0-macos and one with net10.0 TFM for Linux.-->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
  </PropertyGroup>

  <PropertyGroup>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <!-- Release builds: `dotnet publish -c Release -r <rid>` gives one self-contained executable.
       No trimming: parsers, plugins and console modules are found by reflection. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <AssemblyName>RomManager</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AvaloniaUI\AvaloniaUI.csproj" />
  </ItemGroup>

  <!-- Console modules are not referenced by the app: they are built, then copied into Consoles/ next to it and
       loaded at startup. Deleting one of those DLLs removes that console. -->
  <PropertyGroup>
    <ConsoleModuleRemovedProperties>RuntimeIdentifier;SelfContained;PublishSingleFile;IncludeNativeLibrariesForSelfExtract;_IsPublishing</ConsoleModuleRemovedProperties>
  </PropertyGroup>
  <ItemGroup>
    <ConsoleModule Include="..\..\Consoles\*\*.csproj" />
    <!-- Modules are plain class libraries: never build them for a runtime identifier. -->
    <ProjectReference Include="@(ConsoleModule)" ReferenceOutputAssembly="false" Private="false"
                      GlobalPropertiesToRemove="$(ConsoleModuleRemovedProperties)" />
  </ItemGroup>

  <Target Name="CollectConsoleModules">
    <MSBuild Projects="@(ConsoleModule)" Targets="Build" Properties="Configuration=$(Configuration)"
             RemoveProperties="$(ConsoleModuleRemovedProperties)">
      <Output TaskParameter="TargetOutputs" ItemName="ConsoleModuleDll" />
    </MSBuild>
  </Target>

  <Target Name="CopyConsoleModules" AfterTargets="Build" DependsOnTargets="CollectConsoleModules">
    <Copy SourceFiles="@(ConsoleModuleDll)" DestinationFolder="$(OutDir)Consoles" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishConsoleModules" AfterTargets="Publish" DependsOnTargets="CollectConsoleModules">
    <Copy SourceFiles="@(ConsoleModuleDll)" DestinationFolder="$(PublishDir)Consoles" SkipUnchangedFiles="true" />
  </Target>

  <!-- Plugins that ship with the app: each build output goes to BuiltInPlugins/<Name>/ (trusted without approval). -->
  <ItemGroup>
    <BuiltInPlugin Include="..\..\SamplePlugin\SamplePlugin.csproj;..\..\Plugins\*\*.csproj" />
    <ProjectReference Include="@(BuiltInPlugin)" ReferenceOutputAssembly="false" Private="false"
                      GlobalPropertiesToRemove="$(ConsoleModuleRemovedProperties)" />
  </ItemGroup>

  <Target Name="CollectBuiltInPlugins">
    <MSBuild Projects="@(BuiltInPlugin)" Targets="Build" Properties="Configuration=$(Configuration)"
             RemoveProperties="$(ConsoleModuleRemovedProperties)">
      <Output TaskParameter="TargetOutputs" ItemName="BuiltInPluginDll" />
    </MSBuild>
    <ItemGroup>
      <BuiltInPluginFile Include="%(BuiltInPluginDll.RootDir)%(BuiltInPluginDll.Directory)**\*">
        <Plugin>%(BuiltInPluginDll.Filename)</Plugin>
      </BuiltInPluginFile>
    </ItemGroup>
  </Target>

  <Target Name="CopyBuiltInPlugins" AfterTargets="Build" DependsOnTargets="CollectBuiltInPlugins">
    <Copy SourceFiles="@(BuiltInPluginFile)" SkipUnchangedFiles="true"
          DestinationFiles="@(BuiltInPluginFile->'$(OutDir)BuiltInPlugins\%(Plugin)\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <Target Name="PublishBuiltInPlugins" AfterTargets="Publish" DependsOnTargets="CollectBuiltInPlugins">
    <Copy SourceFiles="@(BuiltInPluginFile)" SkipUnchangedFiles="true"
          DestinationFiles="@(BuiltInPluginFile->'$(PublishDir)BuiltInPlugins\%(Plugin)\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>
</Project>
