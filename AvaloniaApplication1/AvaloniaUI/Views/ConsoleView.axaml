<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:AvaloniaUI.Resources"
             xmlns:vm="using:AvaloniaUI.ViewModels"
             xmlns:views="using:AvaloniaUI.Views"
             x:Class="AvaloniaUI.Views.ConsoleView"
             x:DataType="vm:ConsoleViewModelBase">
    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="banner" IsVisible="{Binding HasOfflineFolders}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Console_RemoveFolder}" Classes="small" Margin="8,0,0,0"
                        Command="{Binding RemoveOfflineFoldersCommand}"
                        ToolTip.Tip="{x:Static res:Strings.Console_ForFoldersThatAreGoneForGoodNoFilesAreTouched}" />
                <TextBlock Text="{Binding OfflineText}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Top" Classes="banner"
                IsVisible="{Binding RequirementsWarning, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding RequirementsWarning}" TextWrapping="Wrap" />
        </Border>

        <!-- Header: name + actions + filter -->
        <DockPanel DockPanel.Dock="Top" Margin="10,8,10,4" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="{Binding DisplayName}" Classes="h2" VerticalAlignment="Center" />
            <TextBlock DockPanel.Dock="Left" Text="{Binding RomCount, StringFormat={x:Static res:Strings.Common_0N0ROMs}}"
                       Classes="muted" VerticalAlignment="Center" Margin="10,0,0,0" />

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                <TextBox x:Name="SearchBox" Width="220" PlaceholderText="{x:Static res:Strings.Console_FilterCtrlF}" Text="{Binding SearchText}" />
                <ToggleButton Content="{x:Static res:Strings.Console_Cards}" IsChecked="{Binding IsCardView}" ToolTip.Tip="{x:Static res:Strings.Console_ShowCoversInsteadOfTheTable}" />
                <ToggleButton Content="{x:Static res:Strings.Console_Group}" IsChecked="{Binding IsGrouped}" IsEnabled="{Binding !IsCardView}"
                              ToolTip.Tip="{x:Static res:Strings.Console_GroupUpdatesAndDLCUnderTheirGame}" />
                <Button x:Name="ColumnsButton" Content="{x:Static res:Strings.Common_Columns}" />
                <Button Content="{x:Static res:Strings.Console_Export}" Command="{Binding ExportShownCommand}" ToolTip.Tip="{x:Static res:Strings.Console_SaveTheRowsShownAfterFiltersAsCSVOrJSON}" />
                <Button Content="{x:Static res:Strings.Console_Verify}" Command="{Binding VerifyCommand}"
                        ToolTip.Tip="{x:Static res:Strings.Console_WhichDumpsMatchYourDATsExactlyAndWhichDoNot}" />
                <Button Content="{x:Static res:Strings.Console_Duplicates}" Command="{Binding ResolveDuplicatesCommand}" IsVisible="{Binding HasDuplicates}"
                        ToolTip.Tip="{x:Static res:Strings.Console_KeepOneFileOfEachRomStoredMoreThanOnceAndMoveThe}" />
                <Button Content="1G1R…" Command="{Binding OneGameOneRomCommand}"
                        ToolTip.Tip="{x:Static res:Strings.Console_OneGameOneROMKeepTheBestVersionOfEachGameByRegio}" />
                <Button Content="{x:Static res:Strings.Common_MissingUpdates}" Command="{Binding CheckMissingUpdatesCommand}"
                        IsVisible="{Binding CanCheckUpdates}" ToolTip.Tip="{x:Static res:Strings.Console_ListGamesWithANewerUpdateThanTheOneInTheLibrary}" />
                <Button Content="{x:Static res:Strings.Console_MissingDLC}" Command="{Binding CheckMissingDlcCommand}"
                        IsVisible="{Binding CanCheckDlc}" ToolTip.Tip="{x:Static res:Strings.Console_ListDLCTheTitleDatabaseKnowsForYourGamesThatTheL}" />
                <Button Content="{x:Static res:Strings.Console_Scan}" Command="{Binding LoadDataCommand}" ToolTip.Tip="{x:Static res:Strings.Console_ScanForNewOrChangedFiles}" />
                <Button Content="{x:Static res:Strings.Console_FullRescan}" Command="{Binding RescanCommand}" ToolTip.Tip="{x:Static res:Strings.Console_ReReadEveryFileIgnoringTheCache}" />
            </StackPanel>
        </DockPanel>

        <!-- Filters -->
        <WrapPanel DockPanel.Dock="Top" Margin="10,0,10,6" ItemSpacing="8" LineSpacing="6">
            <TextBlock Text="{x:Static res:Strings.Console_Type}" VerticalAlignment="Center" Classes="muted" />
            <ComboBox ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding TypeFilter}" MinWidth="110" />
            <TextBlock Text="{x:Static res:Strings.Console_Region}" VerticalAlignment="Center" Classes="muted" Margin="6,0,0,0" />
            <ComboBox ItemsSource="{Binding RegionOptions}" SelectedItem="{Binding RegionFilter}" MinWidth="110" />
            <TextBlock Text="{x:Static res:Strings.Console_Language}" VerticalAlignment="Center" Classes="muted" Margin="6,0,0,0" />
            <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding LanguageFilter}" MinWidth="110" />
            <TextBlock Text="{x:Static res:Strings.Console_Format}" VerticalAlignment="Center" Classes="muted" Margin="6,0,0,0" />
            <ComboBox ItemsSource="{Binding FormatOptions}" SelectedItem="{Binding FormatFilter}" MinWidth="90" />
            <TextBlock Text="{x:Static res:Strings.Common_Updates}" VerticalAlignment="Center" Classes="muted" Margin="6,0,0,0" />
            <ComboBox ItemsSource="{Binding UpdateOptions}" SelectedItem="{Binding UpdateFilter}" MinWidth="120" />
            <CheckBox Content="{x:Static res:Strings.Console_UnnamedOnly}" IsChecked="{Binding UnnamedOnly}" Margin="6,0,0,0"
                      ToolTip.Tip="{x:Static res:Strings.Console_ROMsWithNoTitleOrOnlyTheirFileNameAsTitle}" />
            <CheckBox Content="{x:Static res:Strings.Common_Duplicates}" IsChecked="{Binding DuplicatesOnly}"
                      ToolTip.Tip="{x:Static res:Strings.Common_FilesWithTheSameTitleIDTypeAndVersionAsAnotherFi}" />
            <Button Content="{x:Static res:Strings.Console_ClearFilters}" Classes="small" Command="{Binding ClearFiltersCommand}"
                    IsVisible="{Binding IsFiltered}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding RomsView.Count, StringFormat={x:Static res:Strings.Console_0N0Shown}}" Classes="muted"
                       VerticalAlignment="Center" IsVisible="{Binding IsFiltered}" />
        </WrapPanel>

        <!-- Scan status -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="10,0,10,4">
            <ProgressBar Width="120" MinWidth="120" Height="6" MinHeight="6" VerticalAlignment="Center"
                         IsVisible="{Binding IsLoading}" IsIndeterminate="{Binding IsIndeterminate}"
                         Value="{Binding ProgressPercent}" />
            <Button Content="{x:Static res:Strings.Common_Cancel}" Classes="small" Command="{Binding CancelScanCommand}" IsVisible="{Binding IsLoading}" />
            <SelectableTextBlock Text="{Binding StatusMessage}" Classes="muted" VerticalAlignment="Center" />
            <Button Content="{Binding UnrecognizedText}" Classes="small" Command="{Binding ShowUnrecognizedCommand}"
                    IsVisible="{Binding UnrecognizedText, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <Grid ColumnDefinitions="*,4,300">
            <Panel>
                <DataGrid x:Name="RomsGrid"
                          ItemsSource="{Binding RomsView}"
                          SelectedItem="{Binding SelectedRom, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True"
                          CanUserReorderColumns="True" CanUserResizeColumns="True"
                          SelectionMode="Extended" GridLinesVisibility="Horizontal" Margin="4,0"
                          IsVisible="{Binding !IsCardView}">
                    <DataGrid.ContextMenu>
                        <ContextMenu x:Name="RomMenu" />
                    </DataGrid.ContextMenu>
                </DataGrid>

                <ScrollViewer IsVisible="{Binding IsCardView}" Margin="8,0">
                    <ItemsRepeater x:Name="Cards" ItemsSource="{Binding RomsView}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="150" MinItemHeight="200" MinRowSpacing="8" MinColumnSpacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:RomViewModel">
                                <Button Classes="card"
                                        Command="{Binding $parent[views:ConsoleView].((vm:ConsoleViewModelBase)DataContext).SelectRomCommand}"
                                        CommandParameter="{Binding}" ToolTip.Tip="{Binding Path}"
                                        AutomationProperties.Name="{Binding Title}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding RomType}" Classes="muted" />
                                        </StackPanel>
                                        <Border Classes="cover">
                                            <Panel>
                                                <TextBlock Text="{Binding Initials}" Classes="initials"
                                                           IsVisible="{Binding Cover, Converter={x:Static ObjectConverters.IsNull}}" />
                                                <Image Source="{Binding Cover}" Stretch="Uniform" AutomationProperties.Name="{x:Static res:Strings.Console_Cover}" />
                                            </Panel>
                                        </Border>
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>

                <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsVisible="{Binding ShowEmptyState}">
                    <TextBlock Text="{Binding DisplayName, StringFormat={x:Static res:Strings.Console_No0ROMsYet}}" Classes="h3" HorizontalAlignment="Center" />
                    <TextBlock Text="{x:Static res:Strings.Console_ChooseTheFolderThatHoldsYourROMsInSettingsThenSc}" Classes="muted" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Button Content="{x:Static res:Strings.Common_OpenSettings}"
                                Command="{Binding $parent[views:MainView].((vm:MainViewModel)DataContext).OpenSettingsCommand}" />
                        <Button Content="{x:Static res:Strings.Console_ScanNow}" Command="{Binding LoadDataCommand}" />
                    </StackPanel>
                </StackPanel>
            </Panel>

            <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

            <ScrollViewer Grid.Column="2">
                <Panel>
                    <TextBlock Text="{x:Static res:Strings.Console_SelectAROMToSeeDetails}" Classes="muted" Margin="10"
                               IsVisible="{Binding Details, Converter={x:Static ObjectConverters.IsNull}}" />
                    <ContentControl Content="{Binding Details}" />
                </Panel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
