<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvaloniaUI.ViewModels"
             xmlns:views="using:AvaloniaUI.Views"
             x:Class="AvaloniaUI.Views.ConsoleView"
             x:DataType="vm:ConsoleViewModelBase">
    <DockPanel>
        <Border DockPanel.Dock="Top" Classes="banner" IsVisible="{Binding HasOfflineFolders}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Remove folder…" Classes="small" Margin="8,0,0,0"
                        Command="{Binding RemoveOfflineFoldersCommand}"
                        ToolTip.Tip="For folders that are gone for good; no files are touched" />
                <TextBlock Text="{Binding OfflineText}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <Border DockPanel.Dock="Top" Classes="banner"
                IsVisible="{Binding RequirementsWarning, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding RequirementsWarning}" TextWrapping="Wrap" />
        </Border>

        <!-- Header: name + actions + filter -->
        <DockPanel DockPanel.Dock="Top" Margin="10,8,10,4" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="{Binding DisplayName}" Classes="h2" VerticalAlignment="Center" />
            <TextBlock DockPanel.Dock="Left" Text="{Binding RomCount, StringFormat='{}{0:N0} ROMs'}"
                       Classes="muted" VerticalAlignment="Center" Margin="10,0,0,0" />

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                <TextBox x:Name="SearchBox" Width="220" Watermark="Filter (Ctrl+F)" Text="{Binding SearchText}" />
                <ToggleButton Content="Cards" IsChecked="{Binding IsCardView}" ToolTip.Tip="Show covers instead of the table" />
                <ToggleButton Content="Group" IsChecked="{Binding IsGrouped}" IsEnabled="{Binding !IsCardView}"
                              ToolTip.Tip="Group updates and DLC under their game" />
                <Button x:Name="ColumnsButton" Content="Columns" />
                <Button Content="Export…" Command="{Binding ExportShownCommand}" ToolTip.Tip="Save the rows shown (after filters) as CSV or JSON" />
                <Button Content="Duplicates…" Command="{Binding ResolveDuplicatesCommand}" IsVisible="{Binding HasDuplicates}"
                        ToolTip.Tip="Keep one file of each rom stored more than once and move the other copies" />
                <Button Content="1G1R…" Command="{Binding OneGameOneRomCommand}"
                        ToolTip.Tip="One game, one ROM: keep the best version of each game by region priority and move the others" />
                <Button Content="Missing updates" Command="{Binding CheckMissingUpdatesCommand}"
                        IsVisible="{Binding CanCheckUpdates}" ToolTip.Tip="List games with a newer update than the one in the library" />
                <Button Content="Missing DLC" Command="{Binding CheckMissingDlcCommand}"
                        IsVisible="{Binding CanCheckDlc}" ToolTip.Tip="List DLC the title database knows for your games that the library lacks" />
                <Button Content="Scan" Command="{Binding LoadDataCommand}" ToolTip.Tip="Scan for new or changed files" />
                <Button Content="Full rescan" Command="{Binding RescanCommand}" ToolTip.Tip="Re-read every file, ignoring the cache" />
            </StackPanel>
        </DockPanel>

        <!-- Filters -->
        <WrapPanel DockPanel.Dock="Top" Margin="10,0,10,6" ItemSpacing="8" LineSpacing="6">
            <TextBlock Text="Type" VerticalAlignment="Center" Classes="muted" />
            <ComboBox ItemsSource="{Binding TypeOptions}" SelectedItem="{Binding TypeFilter}" MinWidth="110" />
            <TextBlock Text="Region" VerticalAlignment="Center" Classes="muted" Margin="6,0,0,0" />
            <ComboBox ItemsSource="{Binding RegionOptions}" SelectedItem="{Binding RegionFilter}" MinWidth="110" />
            <TextBlock Text="Language" VerticalAlignment="Center" Classes="muted" Margin="6,0,0,0" />
            <ComboBox ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding LanguageFilter}" MinWidth="110" />
            <TextBlock Text="Format" VerticalAlignment="Center" Classes="muted" Margin="6,0,0,0" />
            <ComboBox ItemsSource="{Binding FormatOptions}" SelectedItem="{Binding FormatFilter}" MinWidth="90" />
            <TextBlock Text="Updates" VerticalAlignment="Center" Classes="muted" Margin="6,0,0,0" />
            <ComboBox ItemsSource="{Binding UpdateOptions}" SelectedItem="{Binding UpdateFilter}" MinWidth="120" />
            <CheckBox Content="Unnamed only" IsChecked="{Binding UnnamedOnly}" Margin="6,0,0,0"
                      ToolTip.Tip="ROMs with no title or only their file name as title" />
            <CheckBox Content="Duplicates" IsChecked="{Binding DuplicatesOnly}"
                      ToolTip.Tip="Files with the same title ID, type and version as another file" />
            <Button Content="Clear filters" Classes="small" Command="{Binding ClearFiltersCommand}"
                    IsVisible="{Binding IsFiltered}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding RomsView.Count, StringFormat='{}{0:N0} shown'}" Classes="muted"
                       VerticalAlignment="Center" IsVisible="{Binding IsFiltered}" />
        </WrapPanel>

        <!-- Scan status -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="10,0,10,4">
            <ProgressBar Width="120" MinWidth="120" Height="6" MinHeight="6" VerticalAlignment="Center"
                         IsVisible="{Binding IsLoading}" IsIndeterminate="{Binding IsIndeterminate}"
                         Value="{Binding ProgressPercent}" />
            <Button Content="Cancel" Classes="small" Command="{Binding CancelScanCommand}" IsVisible="{Binding IsLoading}" />
            <SelectableTextBlock Text="{Binding StatusMessage}" Classes="muted" VerticalAlignment="Center" />
            <Button Content="{Binding UnrecognizedText}" Classes="small" Command="{Binding ShowUnrecognizedCommand}"
                    IsVisible="{Binding UnrecognizedText, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <Grid ColumnDefinitions="*,4,300">
            <Panel>
                <DataGrid x:Name="RomsGrid"
                          ItemsSource="{Binding RomsView}"
                          SelectedItem="{Binding SelectedRom, Mode=TwoWay}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True"
                          CanUserReorderColumns="True" CanUserResizeColumns="True"
                          SelectionMode="Extended" GridLinesVisibility="Horizontal" Margin="4,0"
                          IsVisible="{Binding !IsCardView}">
                    <DataGrid.ContextMenu>
                        <ContextMenu x:Name="RomMenu" />
                    </DataGrid.ContextMenu>
                </DataGrid>

                <ScrollViewer IsVisible="{Binding IsCardView}" Margin="8,0">
                    <ItemsRepeater x:Name="Cards" ItemsSource="{Binding RomsView}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="150" MinItemHeight="200" MinRowSpacing="8" MinColumnSpacing="8" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="vm:RomViewModel">
                                <Button Classes="card"
                                        Command="{Binding $parent[views:ConsoleView].((vm:ConsoleViewModelBase)DataContext).SelectRomCommand}"
                                        CommandParameter="{Binding}" ToolTip.Tip="{Binding Path}"
                                        AutomationProperties.Name="{Binding Title}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding RomType}" Classes="muted" />
                                        </StackPanel>
                                        <Border Classes="cover">
                                            <Panel>
                                                <TextBlock Text="{Binding Initials}" Classes="initials"
                                                           IsVisible="{Binding Cover, Converter={x:Static ObjectConverters.IsNull}}" />
                                                <Image Source="{Binding Cover}" Stretch="Uniform" AutomationProperties.Name="Cover" />
                                            </Panel>
                                        </Border>
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>
                </ScrollViewer>

                <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center"
                            IsVisible="{Binding ShowEmptyState}">
                    <TextBlock Text="{Binding DisplayName, StringFormat='No {0} ROMs yet'}" Classes="h3" HorizontalAlignment="Center" />
                    <TextBlock Text="Choose the folder that holds your ROMs in Settings, then scan it." Classes="muted" />
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <Button Content="Open Settings…"
                                Command="{Binding $parent[views:MainView].((vm:MainViewModel)DataContext).OpenSettingsCommand}" />
                        <Button Content="Scan now" Command="{Binding LoadDataCommand}" />
                    </StackPanel>
                </StackPanel>
            </Panel>

            <GridSplitter Grid.Column="1" ResizeDirection="Columns" />

            <ScrollViewer Grid.Column="2">
                <Panel>
                    <TextBlock Text="Select a ROM to see details." Classes="muted" Margin="10"
                               IsVisible="{Binding Details, Converter={x:Static ObjectConverters.IsNull}}" />
                    <ContentControl Content="{Binding Details}" />
                </Panel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</UserControl>
