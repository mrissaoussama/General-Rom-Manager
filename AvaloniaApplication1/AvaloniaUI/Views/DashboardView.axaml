<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:AvaloniaUI.Resources"
             xmlns:vm="using:AvaloniaUI.ViewModels"
             xmlns:views="using:AvaloniaUI.Views"
             x:Class="AvaloniaUI.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
    <ScrollViewer>
        <StackPanel Margin="20" Spacing="18">
            <TextBlock Text="{x:Static res:Strings.Dashboard_Library}" Classes="h1" />

            <WrapPanel>
                <Border Classes="stat">
                    <StackPanel>
                        <TextBlock Classes="stat-value" Text="{Binding TotalRoms, StringFormat='{}{0:N0}'}" />
                        <TextBlock Classes="stat-label" Text="{x:Static res:Strings.Dashboard_ROMs}" />
                    </StackPanel>
                </Border>
                <Border Classes="stat">
                    <StackPanel>
                        <TextBlock Classes="stat-value" Text="{Binding Games, StringFormat='{}{0:N0}'}" />
                        <TextBlock Classes="stat-label" Text="{x:Static res:Strings.Dashboard_Games}" />
                    </StackPanel>
                </Border>
                <Border Classes="stat">
                    <StackPanel>
                        <TextBlock Classes="stat-value" Text="{Binding Updates, StringFormat='{}{0:N0}'}" />
                        <TextBlock Classes="stat-label" Text="{x:Static res:Strings.Common_Updates}" />
                    </StackPanel>
                </Border>
                <Border Classes="stat">
                    <StackPanel>
                        <TextBlock Classes="stat-value" Text="{Binding Dlcs, StringFormat='{}{0:N0}'}" />
                        <TextBlock Classes="stat-label" Text="{x:Static res:Strings.Dashboard_DLC}" />
                    </StackPanel>
                </Border>
                <Border Classes="stat">
                    <StackPanel>
                        <TextBlock Classes="stat-value" Text="{Binding Unidentified, StringFormat='{}{0:N0}'}" />
                        <TextBlock Classes="stat-label" Text="{x:Static res:Strings.Dashboard_WithoutAName}" />
                    </StackPanel>
                </Border>
                <Border Classes="stat">
                    <StackPanel>
                        <TextBlock Classes="stat-value" Text="{Binding TotalSize}" />
                        <TextBlock Classes="stat-label" Text="{x:Static res:Strings.Dashboard_OnDisk}" />
                    </StackPanel>
                </Border>
                <Border Classes="stat" ToolTip.Tip="{x:Static res:Strings.Common_FilesWithTheSameTitleIDTypeAndVersionAsAnotherFi}">
                    <StackPanel>
                        <TextBlock Classes="stat-value" Text="{Binding Duplicates, StringFormat='{}{0:N0}'}" />
                        <TextBlock Classes="stat-label" Text="{x:Static res:Strings.Common_Duplicates}" />
                    </StackPanel>
                </Border>
                <Border Classes="stat" IsVisible="{Binding HasMissingUpdates}"
                        ToolTip.Tip="{x:Static res:Strings.Dashboard_GamesWithANewerUpdateThanTheNewestOneInTheLibrar}">
                    <StackPanel>
                        <TextBlock Classes="stat-value" Text="{Binding MissingUpdates, StringFormat='{}{0:N0}'}" />
                        <TextBlock Classes="stat-label" Text="{x:Static res:Strings.Common_MissingUpdates}" />
                    </StackPanel>
                </Border>
                <Border Classes="stat" ToolTip.Tip="{x:Static res:Strings.Dashboard_FilesWithAROMExtensionThatNoParserCouldRead}">
                    <StackPanel>
                        <TextBlock Classes="stat-value" Text="{Binding NotRecognised, StringFormat='{}{0:N0}'}" />
                        <TextBlock Classes="stat-label" Text="{x:Static res:Strings.Dashboard_NotRecognised}" />
                    </StackPanel>
                </Border>
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="{x:Static res:Strings.Dashboard_ScanErrorsAndUnrecognisedFilesAreWrittenToTheLog}" Classes="muted"
                           VerticalAlignment="Center" />
                <Button Content="{x:Static res:Strings.Dashboard_OpenLog}" Classes="small"
                        Command="{Binding $parent[views:MainView].((vm:MainViewModel)DataContext).ShowLogCommand}" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="{x:Static res:Strings.Dashboard_DATFiles}" Classes="h3" />
                <TextBlock Text="{Binding DatSummary}" Classes="muted" TextWrapping="Wrap" />
                <SelectableTextBlock Text="{Binding DatDirectory}" Classes="muted" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{x:Static res:Strings.Dashboard_OpenFolder}" Classes="small" Command="{Binding OpenDatFolderCommand}" />
                    <Button Content="{x:Static res:Strings.Common_Refresh}" Classes="small" Command="{Binding RefreshDatsCommand}" />
                    <Button Content="{x:Static res:Strings.Dashboard_HaveMissReport}" Classes="small" Command="{Binding ShowDatCoverageCommand}"
                            ToolTip.Tip="{x:Static res:Strings.Dashboard_WhichGamesOfEachDATSetAreInTheLibrary}" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="{x:Static res:Strings.Common_Consoles}" Classes="h2" />

            <StackPanel Spacing="8" IsVisible="{Binding !HasConsoles}">
                <TextBlock Text="{x:Static res:Strings.Dashboard_NoROMFoldersConfiguredYet}" />
                <Button Content="{x:Static res:Strings.Common_OpenSettings}" HorizontalAlignment="Left"
                        Command="{Binding $parent[views:MainView].((vm:MainViewModel)DataContext).OpenSettingsCommand}" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Consoles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConsoleViewModelBase">
                        <Button Classes="tile" AutomationProperties.Name="{Binding DisplayName}"
                                Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).OpenCommand}"
                                CommandParameter="{Binding}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding DisplayName}" Classes="h3" />
                                <TextBlock Text="{Binding RomCount, StringFormat={x:Static res:Strings.Common_0N0ROMs}}" />
                                <TextBlock Text="{Binding StatusMessage}" Classes="muted" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding LastScanText}" Classes="muted" />
                                <TextBlock Text="{Binding DuplicateCount, StringFormat={x:Static res:Strings.Dashboard_0N0DuplicateFileS}}" Classes="muted"
                                           IsVisible="{Binding HasDuplicates}" />
                                <TextBlock Text="{x:Static res:Strings.Dashboard_FolderOffline}" Classes="warning" IsVisible="{Binding HasOfflineFolders}" />
                                <TextBlock Text="{Binding UnrecognizedText}" Classes="muted"
                                           IsVisible="{Binding UnrecognizedText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <ProgressBar IsVisible="{Binding IsLoading}" IsIndeterminate="{Binding IsIndeterminate}"
                                             Value="{Binding ProgressPercent}" Height="4" MinHeight="4" />
                                <TextBlock Text="{x:Static res:Strings.Dashboard_MissingRequirements}" Classes="warning"
                                           IsVisible="{Binding RequirementsWarning, Converter={x:Static ObjectConverters.IsNotNull}}"
                                           ToolTip.Tip="{Binding RequirementsWarning}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
