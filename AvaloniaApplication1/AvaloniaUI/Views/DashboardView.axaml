<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvaloniaUI.ViewModels"
             xmlns:views="using:AvaloniaUI.Views"
             x:Class="AvaloniaUI.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
    <ScrollViewer>
        <StackPanel Margin="20" Spacing="18">
            <TextBlock Text="Library" Classes="h1" />

            <WrapPanel>
                <Border Classes="stat">
                    <StackPanel>
                        <TextBlock Classes="stat-value" Text="{Binding TotalRoms, StringFormat='{}{0:N0}'}" />
                        <TextBlock Classes="stat-label" Text="ROMs" />
                    </StackPanel>
                </Border>
                <Border Classes="stat">
                    <StackPanel>
                        <TextBlock Classes="stat-value" Text="{Binding Games, StringFormat='{}{0:N0}'}" />
                        <TextBlock Classes="stat-label" Text="Games" />
                    </StackPanel>
                </Border>
                <Border Classes="stat">
                    <StackPanel>
                        <TextBlock Classes="stat-value" Text="{Binding Updates, StringFormat='{}{0:N0}'}" />
                        <TextBlock Classes="stat-label" Text="Updates" />
                    </StackPanel>
                </Border>
                <Border Classes="stat">
                    <StackPanel>
                        <TextBlock Classes="stat-value" Text="{Binding Dlcs, StringFormat='{}{0:N0}'}" />
                        <TextBlock Classes="stat-label" Text="DLC" />
                    </StackPanel>
                </Border>
                <Border Classes="stat">
                    <StackPanel>
                        <TextBlock Classes="stat-value" Text="{Binding Unidentified, StringFormat='{}{0:N0}'}" />
                        <TextBlock Classes="stat-label" Text="Without a name" />
                    </StackPanel>
                </Border>
                <Border Classes="stat">
                    <StackPanel>
                        <TextBlock Classes="stat-value" Text="{Binding TotalSize}" />
                        <TextBlock Classes="stat-label" Text="On disk" />
                    </StackPanel>
                </Border>
                <Border Classes="stat" ToolTip.Tip="Files with the same title ID, type and version as another file">
                    <StackPanel>
                        <TextBlock Classes="stat-value" Text="{Binding Duplicates, StringFormat='{}{0:N0}'}" />
                        <TextBlock Classes="stat-label" Text="Duplicates" />
                    </StackPanel>
                </Border>
                <Border Classes="stat" IsVisible="{Binding HasMissingUpdates}"
                        ToolTip.Tip="Games with a newer update than the newest one in the library (consoles with a version database)">
                    <StackPanel>
                        <TextBlock Classes="stat-value" Text="{Binding MissingUpdates, StringFormat='{}{0:N0}'}" />
                        <TextBlock Classes="stat-label" Text="Missing updates" />
                    </StackPanel>
                </Border>
                <Border Classes="stat" ToolTip.Tip="Files with a ROM extension that no parser could read">
                    <StackPanel>
                        <TextBlock Classes="stat-value" Text="{Binding NotRecognised, StringFormat='{}{0:N0}'}" />
                        <TextBlock Classes="stat-label" Text="Not recognised" />
                    </StackPanel>
                </Border>
            </WrapPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Scan errors and unrecognised files are written to the log." Classes="muted"
                           VerticalAlignment="Center" />
                <Button Content="Open log" Classes="small"
                        Command="{Binding $parent[views:MainView].((vm:MainViewModel)DataContext).ShowLogCommand}" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBlock Text="DAT files" Classes="h3" />
                <TextBlock Text="{Binding DatSummary}" Classes="muted" TextWrapping="Wrap" />
                <SelectableTextBlock Text="{Binding DatDirectory}" Classes="muted" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Open folder" Classes="small" Command="{Binding OpenDatFolderCommand}" />
                    <Button Content="Refresh" Classes="small" Command="{Binding RefreshDatsCommand}" />
                    <Button Content="Have/miss report…" Classes="small" Command="{Binding ShowDatCoverageCommand}"
                            ToolTip.Tip="Which games of each DAT set are in the library" />
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Consoles" Classes="h2" />

            <StackPanel Spacing="8" IsVisible="{Binding !HasConsoles}">
                <TextBlock Text="No ROM folders configured yet." />
                <Button Content="Open Settings…" HorizontalAlignment="Left"
                        Command="{Binding $parent[views:MainView].((vm:MainViewModel)DataContext).OpenSettingsCommand}" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Consoles}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ConsoleViewModelBase">
                        <Button Classes="tile" AutomationProperties.Name="{Binding DisplayName}"
                                Command="{Binding $parent[ItemsControl].((vm:DashboardViewModel)DataContext).OpenCommand}"
                                CommandParameter="{Binding}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{Binding DisplayName}" Classes="h3" />
                                <TextBlock Text="{Binding RomCount, StringFormat='{}{0:N0} ROMs'}" />
                                <TextBlock Text="{Binding StatusMessage}" Classes="muted" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding LastScanText}" Classes="muted" />
                                <TextBlock Text="{Binding DuplicateCount, StringFormat='{}{0:N0} duplicate file(s)'}" Classes="muted"
                                           IsVisible="{Binding HasDuplicates}" />
                                <TextBlock Text="Folder offline" Classes="warning" IsVisible="{Binding HasOfflineFolders}" />
                                <TextBlock Text="{Binding UnrecognizedText}" Classes="muted"
                                           IsVisible="{Binding UnrecognizedText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <ProgressBar IsVisible="{Binding IsLoading}" IsIndeterminate="{Binding IsIndeterminate}"
                                             Value="{Binding ProgressPercent}" Height="4" MinHeight="4" />
                                <TextBlock Text="Missing requirements" Classes="warning"
                                           IsVisible="{Binding RequirementsWarning, Converter={x:Static ObjectConverters.IsNotNull}}"
                                           ToolTip.Tip="{Binding RequirementsWarning}" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
