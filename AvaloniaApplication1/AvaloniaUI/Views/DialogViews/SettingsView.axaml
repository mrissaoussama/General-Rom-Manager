<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvaloniaUI.ViewModels"
             x:Class="AvaloniaUI.Views.DialogViews.SettingsView"
             x:DataType="vm:SettingsViewModel"
             x:Name="Root">
    <UserControl.Styles>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,2" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Width" Value="150" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.status">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" IsCancel="True" Command="{Binding CancelCommand}" />
            <Button Content="Save" IsDefault="True" Command="{Binding ConfirmCommand}" />
        </StackPanel>

        <TabControl>
            <!-- ── General ─────────────────────────────────────────────── -->
            <TabItem Header="General">
                <ScrollViewer>
                    <StackPanel Spacing="6" Margin="4,0,16,8">
                        <TextBlock Classes="heading" Text="Appearance" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="label" Text="Colour theme" />
                            <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.ThemeNames}" SelectedIndex="{Binding ThemeIndex}"
                                      Width="200" AutomationProperties.Name="Colour theme" />
                        </StackPanel>
                        <CheckBox Content="Compact mode (smaller row height)" IsChecked="{Binding IsCompactMode}" />

                        <TextBlock Classes="heading" Text="Database" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Classes="label" Text="Database folder" />
                            <TextBox Text="{Binding DatabasePath.Value}" Width="320" Watermark="config.json default"
                                     AutomationProperties.Name="Database folder" />
                            <Button Content="Browse…" Command="{Binding BrowseDatabaseCommand}" />
                            <TextBlock Classes="status" Text="{Binding DatabasePath.Status.Text}" Foreground="{Binding DatabasePath.Status.Brush}" />
                        </StackPanel>

                        <TextBlock Classes="heading" Text="ROM folders" />
                        <TextBlock Classes="hint" Text="The folder with each console's ROMs. More folders (separated by ';') are scanned with it as one library." />
                        <ItemsControl ItemsSource="{Binding Consoles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ConsoleSettingsRow">
                                    <StackPanel Spacing="2" Margin="0,2">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Classes="label" Text="{Binding DisplayName}" />
                                            <TextBox Text="{Binding Primary.Value}" Width="320" AutomationProperties.Name="{Binding DisplayName}" />
                                            <Button Content="Browse…" CommandParameter="{Binding}"
                                                    Command="{Binding #Root.((vm:SettingsViewModel)DataContext).BrowseRomFolderCommand}" />
                                            <TextBlock Classes="status" Text="{Binding Primary.Status.Text}" Foreground="{Binding Primary.Status.Brush}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Classes="label" />
                                            <TextBox Text="{Binding ExtraFolders}" Width="320" Watermark="More folders, separated by ';'" />
                                            <Button Content="Add…" CommandParameter="{Binding}"
                                                    Command="{Binding #Root.((vm:SettingsViewModel)DataContext).AddRomFolderCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Classes="heading" Text="Emulators" />
                        <TextBlock Classes="hint" Text="Used by &quot;Launch in emulator&quot;. Arguments: {rom} full path, {dir} its folder, {name} file name." />
                        <ItemsControl ItemsSource="{Binding Consoles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ConsoleSettingsRow">
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2">
                                        <TextBlock Classes="label" Text="{Binding DisplayName}" />
                                        <TextBox Text="{Binding EmulatorPath}" Width="320" Watermark="Program" />
                                        <Button Content="Browse…" CommandParameter="{Binding}"
                                                Command="{Binding #Root.((vm:SettingsViewModel)DataContext).BrowseEmulatorCommand}" />
                                        <TextBox Text="{Binding EmulatorArguments}" Width="140" Watermark="Arguments" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Classes="heading" Text="Scanning" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Classes="label" Text="Rescan every (hours)" />
                            <TextBox Text="{Binding RescanIntervalHours}" Width="60" Watermark="off"
                                     AutomationProperties.Name="Rescan interval in hours" />
                            <TextBlock Classes="hint" VerticalAlignment="Center" Text="Catches changes the folder watchers miss (drives plugged in later, edits from other machines)." />
                        </StackPanel>
                        <TextBlock Classes="hint" Text="Files read at once (empty: automatic, 1 on network drives, otherwise 4) and folders to skip, separated by ';'. A name (Backups) skips that folder anywhere; a path (Updates/old) is relative to the ROM folder." />
                        <ItemsControl ItemsSource="{Binding Consoles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ConsoleSettingsRow">
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2">
                                        <TextBlock Classes="label" Text="{Binding DisplayName}" />
                                        <TextBox Text="{Binding Parallelism}" Width="60" Watermark="auto" />
                                        <TextBox Text="{Binding ExcludedFolders}" Width="320" Watermark="Folders to skip" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Classes="heading" Text="Conversion tools" />
                        <TextBlock Classes="hint" Text="Programs you install yourself for &quot;Convert&quot; in the rom menu. Empty: the Tools folder." />
                        <ItemsControl ItemsSource="{Binding Tools}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ToolPathRow">
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2">
                                        <TextBlock Classes="label" Text="{Binding Tool.DisplayName}" />
                                        <TextBox Text="{Binding Path}" Width="320" Watermark="{Binding Placeholder}" />
                                        <Button Content="Browse…" CommandParameter="{Binding}"
                                                Command="{Binding #Root.((vm:SettingsViewModel)DataContext).BrowseToolCommand}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Classes="heading" Text="File organiser" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Classes="label" Text="1G1R region priority" />
                            <TextBox Text="{Binding RegionPriority}" Width="320" Watermark="USA, World, Europe, Japan" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Classes="label" Text="Rename template" />
                            <TextBox Text="{Binding RenameFormat}" CaretIndex="{Binding RenameCaret, Mode=TwoWay}" Width="420"
                                     AutomationProperties.Name="Rename template" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{x:Static vm:SettingsViewModel.RenamePlaceholders}" Margin="154,0,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Button Content="{Binding}" Classes="small" Margin="0,0,4,4" CommandParameter="{Binding}"
                                            Command="{Binding #Root.((vm:SettingsViewModel)DataContext).InsertPlaceholderCommand}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Classes="heading" Text="Online" />
                        <TextBlock Classes="hint" Text="Everything RomManager fetches from the internet. Scanning itself never goes online." />
                        <CheckBox Content="Download box art (libretro-thumbnails, title databases)" IsChecked="{Binding DownloadBoxArt}" />
                        <CheckBox Content="Download missing title databases on startup (titledb, WikiBrew)" IsChecked="{Binding AutoDownloadMissingDbs}" />
                        <CheckBox Content="PS4 missing updates: ask Sony's update server (one request per game)" IsChecked="{Binding AllowPs4OnlineUpdateCheck}" />
                        <CheckBox Content="Check GitHub for a newer RomManager on startup (installed copies)" IsChecked="{Binding CheckForAppUpdates}" />

                        <TextBlock Classes="heading" Text="Downloads and DATs" />
                        <CheckBox Content="Hash disc images for Redump DAT matching (slow on the first scan; results are cached)"
                                  IsChecked="{Binding HashDiscImages}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Download title databases" Command="{Binding DownloadTitleDatabasesCommand}"
                                    IsEnabled="{Binding CanDownloadTitleDatabases}" />
                            <TextBlock Classes="status" Text="{Binding DownloadStatus}" />
                        </StackPanel>
                        <TextBlock Classes="hint" Text="{Binding DatDirectory, StringFormat='DAT folder: {0}'}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Show DAT files per console" Command="{Binding ShowDatOverviewCommand}" />
                            <Button Content="Open DAT folder" Command="{Binding OpenDatFolderCommand}" />
                        </StackPanel>
                        <TextBlock Classes="hint" Text="{Binding DatOverview}" />

                        <TextBlock Classes="heading" Text="Switch keys" />
                        <TextBlock Classes="hint" Text="{Binding KeysDirectory, StringFormat='Read from {0}. Only counts are shown, never key values.'}" />
                        <ItemsControl ItemsSource="{Binding KeyStatus}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:StatusLine">
                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Content="Refresh" Classes="small" Command="{Binding RefreshKeysCommand}" />

                        <TextBlock Classes="heading" Text="Overrides" />
                        <TextBlock Classes="hint" Text="Leave blank to use the defaults from config.json." />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Classes="label" Text="Switch TitleDB URL" />
                            <TextBox Text="{Binding SwitchTitleDbUrl}" Width="420" Watermark="https://raw.githubusercontent.com/blawar/titledb/master/" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Classes="label" Text="Switch versions URL" />
                            <TextBox Text="{Binding SwitchVersionsUrl}" Width="420" Watermark="https://raw.githubusercontent.com/blawar/titledb/master/versions.json" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Classes="label" Text="Switch TitleDB folder" />
                            <TextBox Text="{Binding SwitchTitleDbPath.Value}" Width="320" Watermark="titledb" />
                            <TextBlock Classes="status" Text="{Binding SwitchTitleDbPath.Status.Text}" Foreground="{Binding SwitchTitleDbPath.Status.Brush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Classes="label" Text="Plugins folder" />
                            <TextBox Text="{Binding PluginsDirectory.Value}" Width="320" />
                            <Button Content="Browse…" Command="{Binding BrowsePluginsDirectoryCommand}" />
                            <TextBlock Classes="status" Text="{Binding PluginsDirectory.Status.Text}" Foreground="{Binding PluginsDirectory.Status.Brush}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── Columns ─────────────────────────────────────────────── -->
            <TabItem Header="Columns">
                <ScrollViewer>
                    <StackPanel Spacing="6" Margin="4,0,16,8">
                        <TextBlock Classes="hint" Text="Columns shown on each console page." />
                        <TextBlock Classes="hint" Text="No consoles yet: add ROM folders on the General tab first."
                                   IsVisible="{Binding !HasColumnGroups}" />
                        <ItemsControl ItemsSource="{Binding ColumnGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ColumnGroup">
                                    <StackPanel Margin="0,4">
                                        <Border Classes="stat" Padding="8,4" Margin="0,0,0,4">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="Reset to defaults" Classes="small" Command="{Binding ResetCommand}" />
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Columns}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ColumnToggle">
                                                    <CheckBox Content="{Binding Header}" IsChecked="{Binding IsVisible}" Margin="0,0,12,4" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── Plugins ─────────────────────────────────────────────── -->
            <TabItem Header="Plugins">
                <DockPanel Margin="4,0,16,8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <Button Content="Import plugin (.zip)…" Command="{Binding ImportPluginCommand}" />
                        <Button Content="Open plugins folder" Command="{Binding OpenPluginsFolderCommand}" />
                        <Button Content="Reload plugins" Command="{Binding ReloadPluginsCommand}" />
                        <TextBlock Classes="status" Text="{Binding PluginStatus}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="hint" IsVisible="{Binding !HasPlugins}"
                               Text="No plugins loaded. Import a .zip, or put a plugin folder in the plugins folder and reload." />
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Plugins}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PluginRow">
                                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                        <DockPanel>
                                            <ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center" IsChecked="{Binding IsEnabled}"
                                                          IsEnabled="{Binding !IsRevoked}" OnContent="Enabled" OffContent="Disabled"
                                                          AutomationProperties.Name="{Binding Name}" />
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" />
                                                <TextBlock Classes="hint" Text="{Binding Description}" />
                                                <TextBlock Classes="hint" Text="{Binding Details}" />
                                                <Button Content="Revoke approval" Classes="small" HorizontalAlignment="Left"
                                                        IsEnabled="{Binding !IsRevoked}" CommandParameter="{Binding}"
                                                        ToolTip.Tip="Ask again before loading this plugin (it stays loaded until restart)"
                                                        Command="{Binding #Root.((vm:SettingsViewModel)DataContext).RevokePluginCommand}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
