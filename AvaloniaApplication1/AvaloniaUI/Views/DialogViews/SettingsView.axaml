<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:AvaloniaUI.Resources"
             xmlns:vm="using:AvaloniaUI.ViewModels"
             x:Class="AvaloniaUI.Views.DialogViews.SettingsView"
             x:DataType="vm:SettingsViewModel"
             x:Name="Root">
    <UserControl.Styles>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,12,0,2" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.label">
            <Setter Property="Width" Value="150" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.status">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Styles>

    <DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="{x:Static res:Strings.Common_Cancel}" IsCancel="True" Command="{Binding CancelCommand}" />
            <Button Content="{x:Static res:Strings.Settings_Save}" IsDefault="True" Command="{Binding ConfirmCommand}" />
        </StackPanel>

        <TabControl>
            <!-- ── General ─────────────────────────────────────────────── -->
            <TabItem Header="{x:Static res:Strings.Common_General}">
                <ScrollViewer>
                    <StackPanel Spacing="6" Margin="4,0,16,8">
                        <TextBlock Classes="heading" Text="{x:Static res:Strings.Settings_Appearance}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Classes="label" Text="{x:Static res:Strings.Settings_ColourTheme}" />
                            <ComboBox ItemsSource="{x:Static vm:SettingsViewModel.ThemeNames}" SelectedIndex="{Binding ThemeIndex}"
                                      Width="200" AutomationProperties.Name="{x:Static res:Strings.Settings_ColourTheme}" />
                        </StackPanel>
                        <CheckBox Content="{x:Static res:Strings.Settings_CompactModeSmallerRowHeight}" IsChecked="{Binding IsCompactMode}" />

                        <TextBlock Classes="heading" Text="{x:Static res:Strings.Settings_Database}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Classes="label" Text="{x:Static res:Strings.Settings_DatabaseFolder}" />
                            <TextBox Text="{Binding DatabasePath.Value}" Width="320" PlaceholderText="{x:Static res:Strings.Settings_ConfigJsonDefault}"
                                     AutomationProperties.Name="{x:Static res:Strings.Settings_DatabaseFolder}" />
                            <Button Content="{x:Static res:Strings.Common_Browse}" Command="{Binding BrowseDatabaseCommand}" />
                            <TextBlock Classes="status" Text="{Binding DatabasePath.Status.Text}" Foreground="{Binding DatabasePath.Status.Brush}" />
                        </StackPanel>

                        <TextBlock Classes="heading" Text="{x:Static res:Strings.Settings_LibraryFolders}" />
                        <TextBlock Classes="hint" TextWrapping="Wrap" Text="{x:Static res:Strings.Settings_LibraryFoldersHint}" />
                        <ItemsControl ItemsSource="{Binding LibraryFolders}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,1">
                                        <TextBlock Text="{Binding}" VerticalAlignment="Center" MinWidth="320" />
                                        <Button Classes="small" Content="{x:Static res:Strings.Console_Remove}" CommandParameter="{Binding}"
                                                Command="{Binding #Root.((vm:SettingsViewModel)DataContext).RemoveLibraryFolderCommand}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Content="{x:Static res:Strings.Settings_AddLibraryFolder}" Command="{Binding AddLibraryFolderCommand}" />
                            <Button Content="{x:Static res:Strings.Settings_CreateConsoleFolders}" Command="{Binding CreateConsoleFoldersCommand}" />
                            <TextBlock Classes="status" Text="{Binding LibraryFoldersStatus}" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Classes="heading" Text="{x:Static res:Strings.Common_ROMFolders}" />
                        <TextBlock Classes="hint" Text="{x:Static res:Strings.Settings_TheFolderWithEachConsoleSROMsMoreFoldersSeparate}" />
                        <ItemsControl ItemsSource="{Binding Consoles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ConsoleSettingsRow">
                                    <StackPanel Spacing="2" Margin="0,2">
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Classes="label" Text="{Binding DisplayName}" />
                                            <TextBox Text="{Binding Primary.Value}" Width="320" AutomationProperties.Name="{Binding DisplayName}" />
                                            <Button Content="{x:Static res:Strings.Common_Browse}" CommandParameter="{Binding}"
                                                    Command="{Binding #Root.((vm:SettingsViewModel)DataContext).BrowseRomFolderCommand}" />
                                            <TextBlock Classes="status" Text="{Binding Primary.Status.Text}" Foreground="{Binding Primary.Status.Brush}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                            <TextBlock Classes="label" />
                                            <TextBox Text="{Binding ExtraFolders}" Width="320" PlaceholderText="{x:Static res:Strings.Settings_MoreFoldersSeparatedBy}" />
                                            <Button Content="{x:Static res:Strings.Settings_Add}" CommandParameter="{Binding}"
                                                    Command="{Binding #Root.((vm:SettingsViewModel)DataContext).AddRomFolderCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Classes="heading" Text="{x:Static res:Strings.Settings_Emulators}" />
                        <TextBlock Classes="hint" Text="{x:Static res:Strings.Settings_UsedByLaunchInEmulatorArgumentsRomFullPathDirIts}" />
                        <ItemsControl ItemsSource="{Binding Consoles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ConsoleSettingsRow">
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2">
                                        <TextBlock Classes="label" Text="{Binding DisplayName}" />
                                        <TextBox Text="{Binding EmulatorPath}" Width="320" PlaceholderText="{x:Static res:Strings.Settings_Program}" />
                                        <Button Content="{x:Static res:Strings.Common_Browse}" CommandParameter="{Binding}"
                                                Command="{Binding #Root.((vm:SettingsViewModel)DataContext).BrowseEmulatorCommand}" />
                                        <TextBox Text="{Binding EmulatorArguments}" Width="140" PlaceholderText="{x:Static res:Strings.Settings_Arguments}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Classes="heading" Text="{x:Static res:Strings.Settings_Scanning}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Classes="label" Text="{x:Static res:Strings.Settings_RescanEveryHours}" />
                            <TextBox Text="{Binding RescanIntervalHours}" Width="60" PlaceholderText="{x:Static res:Strings.Settings_Off}"
                                     AutomationProperties.Name="{x:Static res:Strings.Settings_RescanIntervalInHours}" />
                            <TextBlock Classes="hint" VerticalAlignment="Center" Text="{x:Static res:Strings.Settings_CatchesChangesTheFolderWatchersMissDrivesPlugged}" />
                        </StackPanel>
                        <TextBlock Classes="hint" Text="{x:Static res:Strings.Settings_FilesReadAtOnceEmptyAutomatic1OnNetworkDrivesOth}" />
                        <ItemsControl ItemsSource="{Binding Consoles}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ConsoleSettingsRow">
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2">
                                        <TextBlock Classes="label" Text="{Binding DisplayName}" />
                                        <TextBox Text="{Binding Parallelism}" Width="60" PlaceholderText="{x:Static res:Strings.Settings_Auto}" />
                                        <TextBox Text="{Binding ExcludedFolders}" Width="320" PlaceholderText="{x:Static res:Strings.Settings_FoldersToSkip}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Classes="heading" Text="{x:Static res:Strings.Settings_ConversionTools}" />
                        <TextBlock Classes="hint" Text="{x:Static res:Strings.Settings_ProgramsYouInstallYourselfForConvertInTheRomMenu}" />
                        <ItemsControl ItemsSource="{Binding Tools}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ToolPathRow">
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2">
                                        <TextBlock Classes="label" Text="{Binding Tool.DisplayName}" />
                                        <TextBox Text="{Binding Path}" Width="320" PlaceholderText="{Binding Placeholder}" />
                                        <Button Content="{x:Static res:Strings.Common_Browse}" CommandParameter="{Binding}"
                                                Command="{Binding #Root.((vm:SettingsViewModel)DataContext).BrowseToolCommand}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Classes="heading" Text="{x:Static res:Strings.Settings_FileOrganiser}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Classes="label" Text="{x:Static res:Strings.Settings_1G1RRegionPriority}" />
                            <TextBox Text="{Binding RegionPriority}" Width="320" PlaceholderText="{x:Static res:Strings.Settings_USAWorldEuropeJapan}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Classes="label" Text="{x:Static res:Strings.Settings_RenameTemplate}" />
                            <TextBox Text="{Binding RenameFormat}" CaretIndex="{Binding RenameCaret, Mode=TwoWay}" Width="420"
                                     AutomationProperties.Name="{x:Static res:Strings.Settings_RenameTemplate}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{x:Static vm:SettingsViewModel.RenamePlaceholders}" Margin="154,0,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Button Content="{Binding}" Classes="small" Margin="0,0,4,4" CommandParameter="{Binding}"
                                            Command="{Binding #Root.((vm:SettingsViewModel)DataContext).InsertPlaceholderCommand}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Classes="heading" Text="{x:Static res:Strings.Common_Online}" />
                        <TextBlock Classes="hint" Text="{x:Static res:Strings.Settings_EverythingRomManagerFetchesFromTheInternetScanni}" />
                        <CheckBox Content="{x:Static res:Strings.Settings_DownloadBoxArtLibretroThumbnailsTitleDatabases}" IsChecked="{Binding DownloadBoxArt}" />
                        <CheckBox Content="{x:Static res:Strings.Settings_DownloadMissingTitleDatabasesOnStartupTitledbWik}" IsChecked="{Binding AutoDownloadMissingDbs}" />
                        <CheckBox Content="{x:Static res:Strings.Settings_CheckGitHubForANewerRomManagerOnStartupInstalled}" IsChecked="{Binding CheckForAppUpdates}" />

                        <TextBlock Classes="heading" Text="{x:Static res:Strings.Settings_DownloadsAndDATs}" />
                        <CheckBox Content="{x:Static res:Strings.Settings_HashDiscImagesForRedumpDATMatchingSlowOnTheFirst}"
                                  IsChecked="{Binding HashDiscImages}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{x:Static res:Strings.Settings_DownloadTitleDatabases}" Command="{Binding DownloadTitleDatabasesCommand}"
                                    IsEnabled="{Binding CanDownloadTitleDatabases}" />
                            <TextBlock Classes="status" Text="{Binding DownloadStatus}" />
                        </StackPanel>
                        <TextBlock Classes="hint" Text="{Binding DatDirectory, StringFormat={x:Static res:Strings.Settings_DATFolder0}}" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="{x:Static res:Strings.Settings_ShowDATFilesPerConsole}" Command="{Binding ShowDatOverviewCommand}" />
                            <Button Content="{x:Static res:Strings.Settings_OpenDATFolder}" Command="{Binding OpenDatFolderCommand}" />
                        </StackPanel>
                        <TextBlock Classes="hint" Text="{Binding DatOverview}" />

                        <TextBlock Classes="heading" Text="{x:Static res:Strings.Common_Consoles}" />
                        <TextBlock Classes="hint" Text="{x:Static res:Strings.Settings_OptionsOfTheInstalledConsoleModules}" IsVisible="{Binding HasConsoleGroups}" />
                        <ItemsControl ItemsSource="{Binding ConsoleGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ConsoleOptionsGroup">
                                    <StackPanel Spacing="2" Margin="0,4">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Common_Refresh}" Classes="small" Command="{Binding RefreshStatusCommand}" />
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding Status}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:StatusLine">
                                                    <TextBlock Text="{Binding Text}" Foreground="{Binding Brush}" FontSize="12" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding Fields}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:PluginSettingField">
                                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2" ToolTip.Tip="{Binding Descriptor.Description}">
                                                        <TextBlock Classes="label" Text="{Binding Descriptor.Label}" IsVisible="{Binding !IsBoolean}" />
                                                        <TextBox Text="{Binding Value}" Width="420" IsVisible="{Binding IsText}"
                                                                 PlaceholderText="{Binding Descriptor.Description}" AutomationProperties.Name="{Binding Descriptor.Label}" />
                                                        <TextBox Text="{Binding Value}" Width="300" PasswordChar="•" IsVisible="{Binding IsSecret}"
                                                                 AutomationProperties.Name="{Binding Descriptor.Label}" />
                                                        <CheckBox IsChecked="{Binding BoolValue}" IsVisible="{Binding IsBoolean}"
                                                                  Content="{Binding Descriptor.Label}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Classes="heading" Text="{x:Static res:Strings.Settings_Folders}" />
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Classes="label" Text="{x:Static res:Strings.Settings_PluginsFolder}" />
                            <TextBox Text="{Binding PluginsDirectory.Value}" Width="320" />
                            <Button Content="{x:Static res:Strings.Common_Browse}" Command="{Binding BrowsePluginsDirectoryCommand}" />
                            <TextBlock Classes="status" Text="{Binding PluginsDirectory.Status.Text}" Foreground="{Binding PluginsDirectory.Status.Brush}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── Columns ─────────────────────────────────────────────── -->
            <TabItem Header="{x:Static res:Strings.Common_Columns}">
                <ScrollViewer>
                    <StackPanel Spacing="6" Margin="4,0,16,8">
                        <TextBlock Classes="hint" Text="{x:Static res:Strings.Settings_ColumnsShownOnEachConsolePage}" />
                        <TextBlock Classes="hint" Text="{x:Static res:Strings.Settings_NoConsolesYetAddROMFoldersOnTheGeneralTabFirst}"
                                   IsVisible="{Binding !HasColumnGroups}" />
                        <ItemsControl ItemsSource="{Binding ColumnGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ColumnGroup">
                                    <StackPanel Margin="0,4">
                                        <Border Classes="stat" Padding="8,4" Margin="0,0,0,4">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Settings_ResetToDefaults}" Classes="small" Command="{Binding ResetCommand}" />
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding Columns}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ColumnToggle">
                                                    <CheckBox Content="{Binding Header}" IsChecked="{Binding IsVisible}" Margin="0,0,12,4" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ── Plugins ─────────────────────────────────────────────── -->
            <TabItem Header="{x:Static res:Strings.Settings_Plugins}">
                <DockPanel Margin="4,0,16,8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <Button Content="{x:Static res:Strings.Settings_ImportPluginZip}" Command="{Binding ImportPluginCommand}" />
                        <Button Content="{x:Static res:Strings.Settings_OpenPluginsFolder}" Command="{Binding OpenPluginsFolderCommand}" />
                        <Button Content="{x:Static res:Strings.Settings_ReloadPlugins}" Command="{Binding ReloadPluginsCommand}" />
                        <TextBlock Classes="status" Text="{Binding PluginStatus}" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="hint" IsVisible="{Binding !HasPlugins}"
                               Text="{x:Static res:Strings.Settings_NoPluginsLoadedImportAZipOrPutAPluginFolderInThe}" />
                    <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,8" IsVisible="{Binding HasPluginFailures}">
                        <TextBlock Text="{x:Static res:Strings.Settings_PluginsNotLoaded}" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding PluginFailures}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <TextBlock Classes="hint" Text="{Binding}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Plugins}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PluginRow">
                                    <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
                                        <DockPanel>
                                            <ToggleSwitch DockPanel.Dock="Right" VerticalAlignment="Center" IsChecked="{Binding IsEnabled}"
                                                          IsEnabled="{Binding !IsRevoked}" OnContent="{x:Static res:Strings.Settings_Enabled}" OffContent="{x:Static res:Strings.Settings_Disabled}"
                                                          AutomationProperties.Name="{Binding Name}" />
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Heading}" FontWeight="SemiBold" />
                                                <TextBlock Classes="hint" Text="{Binding Description}" />
                                                <TextBlock Classes="hint" Text="{Binding Details}" />
                                                <ItemsControl ItemsSource="{Binding Fields}" IsVisible="{Binding HasFields}" Margin="0,4">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:PluginSettingField">
                                                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,2"
                                                                        ToolTip.Tip="{Binding Descriptor.Description}">
                                                                <TextBlock Classes="label" Text="{Binding Descriptor.Label}" />
                                                                <TextBox Text="{Binding Value}" Width="300" IsVisible="{Binding IsText}"
                                                                         AutomationProperties.Name="{Binding Descriptor.Label}" />
                                                                <TextBox Text="{Binding Value}" Width="300" PasswordChar="•" IsVisible="{Binding IsSecret}"
                                                                         AutomationProperties.Name="{Binding Descriptor.Label}" />
                                                                <CheckBox IsChecked="{Binding BoolValue}" IsVisible="{Binding IsBoolean}"
                                                                          AutomationProperties.Name="{Binding Descriptor.Label}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Content="{x:Static res:Strings.Settings_RevokeApproval}" Classes="small" HorizontalAlignment="Left"
                                                        IsEnabled="{Binding !IsRevoked}" IsVisible="{Binding !IsBundled}" CommandParameter="{Binding}"
                                                        ToolTip.Tip="{x:Static res:Strings.Settings_AskAgainBeforeLoadingThisPluginItStaysLoadedUnti}"
                                                        Command="{Binding #Root.((vm:SettingsViewModel)DataContext).RevokePluginCommand}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
