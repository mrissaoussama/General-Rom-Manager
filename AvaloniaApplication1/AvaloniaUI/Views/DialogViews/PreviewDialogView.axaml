<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:AvaloniaUI.ViewModels"
             x:Class="AvaloniaUI.Views.DialogViews.PreviewDialogView"
             x:DataType="vm:PreviewDialogViewModel">
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,0,0,8" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Cancel" IsCancel="True" IsVisible="{Binding ShowCancel}" Command="{Binding CancelCommand}" />
            <Button Content="{Binding ConfirmText}" IsDefault="True" Command="{Binding ConfirmCommand}" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Lines}" FontFamily="Cascadia Mono, Consolas, monospace" FontSize="11" />
    </DockPanel>
</UserControl>
