<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:AvaloniaUI.Resources"
             xmlns:vm="using:AvaloniaUI.ViewModels"
             x:Class="AvaloniaUI.Views.DialogViews.ChooseFolderDialogView"
             x:DataType="vm:ChooseFolderDialogViewModel">
    <StackPanel Spacing="8">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        <ListBox ItemsSource="{Binding Folders}" SelectedItem="{Binding Selected}" MaxHeight="240"
                 AutomationProperties.Name="{Binding Message}" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="{x:Static res:Strings.Console_OtherFolder}" Command="{Binding OtherCommand}" />
            <Button Content="{x:Static res:Strings.Common_Cancel}" IsCancel="True" Command="{Binding CancelCommand}" />
            <Button Content="{x:Static res:Strings.Console_Move}" IsDefault="True" Command="{Binding ConfirmCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
