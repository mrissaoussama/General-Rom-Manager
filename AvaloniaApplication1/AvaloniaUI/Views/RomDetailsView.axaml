<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:AvaloniaUI.Resources"
             xmlns:vm="using:AvaloniaUI.ViewModels"
             xmlns:imaging="using:Avalonia.Media.Imaging"
             x:Class="AvaloniaUI.Views.RomDetailsView"
             x:DataType="vm:RomDetailsViewModel"
             x:Name="Root">
    <StackPanel Margin="10" Spacing="4">
        <ItemsControl ItemsSource="{Binding Images}" IsVisible="{Binding HasImages}" Margin="0,0,0,6">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="imaging:Bitmap">
                    <Image Source="{Binding}" MaxWidth="280" MaxHeight="200" Margin="0,0,6,6" Stretch="Uniform" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <SelectableTextBlock Text="{Binding Title}" Classes="h3" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Subtitle}" Classes="muted" Margin="0,0,0,8" />

        <ItemsControl ItemsSource="{Binding Properties}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DetailRow">
                    <Grid ColumnDefinitions="110,*,Auto" Margin="0,1">
                        <TextBlock Text="{Binding Key}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                        <Button Grid.Column="2" Classes="copy" Content="⧉" ToolTip.Tip="{x:Static res:Strings.RomDetails_CopyTip}"
                                AutomationProperties.Name="{x:Static res:Strings.RomDetails_Copy}"
                                Command="{Binding #Root.((vm:RomDetailsViewModel)DataContext).CopyCommand}" CommandParameter="{Binding Value}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,6,0,0" IsVisible="{Binding HasBaseGame}">
            <TextBlock Text="{x:Static res:Strings.RomDetails_BaseGame}" FontWeight="SemiBold" />
            <Button Classes="link" Content="{Binding BaseGame.Text}" ToolTip.Tip="{x:Static res:Strings.RomDetails_OpenTip}"
                    Command="{Binding OpenCommand}" CommandParameter="{Binding BaseGame.Rom}" />
        </StackPanel>

        <StackPanel IsVisible="{Binding Description, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{x:Static res:Strings.RomDetails_Description}" Classes="section" />
            <SelectableTextBlock Text="{Binding Description}" TextWrapping="Wrap" Opacity="0.85" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Sections}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DetailSection">
                    <StackPanel>
                        <TextBlock Text="{Binding Header}" Classes="section" />
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DetailItem">
                                    <Panel Margin="8,0,0,1">
                                        <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" IsVisible="{Binding !IsLink}" />
                                        <Button Classes="link" Content="{Binding Text}" IsVisible="{Binding IsLink}"
                                                ToolTip.Tip="{x:Static res:Strings.RomDetails_OpenTip}"
                                                Command="{Binding #Root.((vm:RomDetailsViewModel)DataContext).OpenCommand}"
                                                CommandParameter="{Binding Rom}" />
                                    </Panel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel IsVisible="{Binding HasSaves}">
            <TextBlock Text="{x:Static res:Strings.RomDetails_SaveData}" Classes="section" />
            <ItemsControl ItemsSource="{Binding Saves}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DetailRow">
                        <Grid ColumnDefinitions="110,*,Auto" Margin="0,1">
                            <TextBlock Text="{Binding Key}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                            <Button Grid.Column="2" Classes="copy" Content="⧉" ToolTip.Tip="{x:Static res:Strings.RomDetails_CopyTip}"
                                    AutomationProperties.Name="{x:Static res:Strings.RomDetails_Copy}"
                                    Command="{Binding #Root.((vm:RomDetailsViewModel)DataContext).CopyCommand}" CommandParameter="{Binding Value}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel IsVisible="{Binding HasHashes}">
            <TextBlock Text="{x:Static res:Strings.RomDetails_Hashes}" Classes="section" />
            <ItemsControl ItemsSource="{Binding Hashes}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DetailRow">
                        <Grid ColumnDefinitions="60,*,Auto" Margin="0,1">
                            <TextBlock Text="{Binding Key}" FontWeight="SemiBold" />
                            <SelectableTextBlock Grid.Column="1" Text="{Binding Value}" Classes="mono" TextWrapping="Wrap" />
                            <Button Grid.Column="2" Classes="copy" Content="⧉" ToolTip.Tip="{x:Static res:Strings.RomDetails_CopyTip}"
                                    AutomationProperties.Name="{x:Static res:Strings.RomDetails_Copy}"
                                    Command="{Binding #Root.((vm:RomDetailsViewModel)DataContext).CopyCommand}" CommandParameter="{Binding Value}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>
