<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="using:AvaloniaUI.Resources"
             xmlns:vm="using:AvaloniaUI.ViewModels"
             x:Class="AvaloniaUI.Views.MainView"
             x:DataType="vm:MainViewModel">
    <UserControl.KeyBindings>
        <KeyBinding Gesture="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Gesture="Shift+F5" Command="{Binding RescanAllCommand}" />
        <KeyBinding Gesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}" />
        <KeyBinding Gesture="Ctrl+D" Command="{Binding ShowDashboardCommand}" />
        <KeyBinding Gesture="Ctrl+L" Command="{Binding ShowLogCommand}" />
    </UserControl.KeyBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="{x:Static res:Strings.Main_File}">
                <MenuItem Header="{x:Static res:Strings.Main_Settings}" InputGesture="Ctrl+OemComma" Command="{Binding OpenSettingsCommand}" />
                <Separator />
                <MenuItem Header="{x:Static res:Strings.Main_EXit}" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="{x:Static res:Strings.Main_View}">
                <MenuItem Header="{x:Static res:Strings.Main_Dashboard2}" InputGesture="Ctrl+D" Command="{Binding ShowDashboardCommand}" />
                <MenuItem Header="{x:Static res:Strings.Main_Log2}" InputGesture="Ctrl+L" Command="{Binding ShowLogCommand}" />
                <Separator />
                <MenuItem Header="{x:Static res:Strings.Main_Theme}">
                    <MenuItem Header="{x:Static res:Strings.Main_System}" Command="{Binding SetThemeCommand}" CommandParameter="Default" />
                    <MenuItem Header="{x:Static res:Strings.Main_Light}" Command="{Binding SetThemeCommand}" CommandParameter="Light" />
                    <MenuItem Header="{x:Static res:Strings.Main_Dark}" Command="{Binding SetThemeCommand}" CommandParameter="Dark" />
                </MenuItem>
                <MenuItem Header="{x:Static res:Strings.Main_CompactRows}" Command="{Binding ToggleCompactModeCommand}" />
            </MenuItem>
            <MenuItem Header="{x:Static res:Strings.Main_Library}">
                <MenuItem Header="{x:Static res:Strings.Main_ScanAll}" InputGesture="F5" Command="{Binding RefreshCommand}" />
                <MenuItem Header="{x:Static res:Strings.Main_FullRescanOfAllConsoles}" InputGesture="Shift+F5" Command="{Binding RescanAllCommand}" />
                <MenuItem Header="{x:Static res:Strings.Main_DownloadMissingDatabases}" Command="{Binding CheckForUpdatesCommand}" />
                <MenuItem Header="{x:Static res:Strings.Main_ExportLibrary}" Command="{Binding ExportLibraryCommand}" />
            </MenuItem>
            <MenuItem Header="{x:Static res:Strings.Main_Help}">
                <MenuItem Header="{x:Static res:Strings.Main_CheckForAppUpdates}" Command="{Binding CheckForAppUpdateCommand}" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom" Classes="statusbar">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" />
                <ProgressBar IsIndeterminate="True" Width="80" MinWidth="80" Height="4" MinHeight="4"
                             VerticalAlignment="Center" IsVisible="{Binding IsAnyLoading}" />
            </StackPanel>
        </Border>

        <Grid ColumnDefinitions="190,4,*" RowDefinitions="*,4,180">
            <!-- Sidebar -->
            <ListBox Grid.RowSpan="3" Classes="sidebar" ItemsSource="{Binding Pages}"
                     SelectedItem="{Binding SelectedPage, Mode=TwoWay}">
                <ListBox.DataTemplates>
                    <DataTemplate DataType="vm:DashboardViewModel">
                        <TextBlock Text="{x:Static res:Strings.Main_Dashboard}" FontWeight="SemiBold" />
                    </DataTemplate>
                    <DataTemplate DataType="vm:ConsoleViewModelBase">
                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto">
                            <Border Background="{Binding BadgeBrush}" CornerRadius="3" Width="34" Height="18" Margin="0,0,8,0"
                                    VerticalAlignment="Center" IsVisible="{Binding Badge, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                <TextBlock Text="{Binding Badge}" Foreground="White" FontSize="10" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" ToolTip.Tip="{Binding DisplayName}" />
                            <TextBlock Grid.Column="2" Text="{Binding RomCount}" Opacity="0.6" VerticalAlignment="Center" />
                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="3" IsIndeterminate="True"
                                         Height="2" MinHeight="2" Margin="0,3,0,0" IsVisible="{Binding IsLoading}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.DataTemplates>
            </ListBox>
            <GridSplitter Grid.Column="1" Grid.RowSpan="3" ResizeDirection="Columns" />

            <!-- Page (dashboard or console); views resolved by ViewLocator -->
            <ContentControl Grid.Column="2" Content="{Binding SelectedPage}" />

            <GridSplitter Grid.Row="1" Grid.Column="2" ResizeDirection="Rows" />

            <TabControl Grid.Row="2" Grid.Column="2" Classes="panel" SelectedIndex="{Binding SelectedBottomTab}">
                <TabItem Header="{x:Static res:Strings.Main_Log}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Classes="toolbar">
                            <Button Content="{x:Static res:Strings.Main_Reload}" Command="{Binding Log.ReloadCommand}" />
                            <Button Content="{x:Static res:Strings.Main_Copy}" Command="{Binding Log.CopyCommand}" />
                            <Button Content="{x:Static res:Strings.Main_OpenFile}" Command="{Binding Log.OpenFileCommand}" />
                        </StackPanel>
                        <ListBox x:Name="LogList" Classes="log" ItemsSource="{Binding Log.Lines}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <SelectableTextBlock Text="{Binding}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </TabItem>

                <TabItem Header="{x:Static res:Strings.Main_Operations}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Classes="toolbar">
                            <Button Content="{x:Static res:Strings.Main_ClearFinished}" Command="{Binding OperationsPanel.ClearFinishedCommand}" />
                            <Button Content="{x:Static res:Strings.Main_CancelAll}" Command="{Binding OperationsPanel.CancelAllCommand}" />
                        </StackPanel>
                        <Panel>
                            <TextBlock Text="{x:Static res:Strings.Main_NoOperationsQueued}" Opacity="0.5" Margin="8"
                                       IsVisible="{Binding OperationsPanel.IsEmpty}" />
                            <ItemsControl ItemsSource="{Binding OperationsPanel.Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:OperationItemViewModel">
                                        <DockPanel Margin="6,2">
                                            <TextBlock DockPanel.Dock="Left" Text="{Binding State}" Width="80" Opacity="0.7" />
                                            <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Common_Cancel}" Classes="small"
                                                    IsVisible="{Binding CanCancel}"
                                                    Command="{Binding $parent[ItemsControl].((vm:OperationsViewModel)DataContext).CancelCommand}"
                                                    CommandParameter="{Binding}" />
                                            <Button DockPanel.Dock="Right" Content="{x:Static res:Strings.Main_Undo}" Classes="small"
                                                    IsVisible="{Binding CanUndo}"
                                                    Command="{Binding $parent[ItemsControl].((vm:OperationsViewModel)DataContext).UndoCommand}"
                                                    CommandParameter="{Binding}" />
                                            <ProgressBar DockPanel.Dock="Right" Width="80" MinWidth="80" Margin="4,0"
                                                         Value="{Binding Progress}" IsVisible="{Binding IsRunning}" />
                                            <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Panel>
                    </DockPanel>
                </TabItem>

                <TabItem Header="{x:Static res:Strings.Main_Downloads}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Classes="toolbar">
                            <Button Content="{x:Static res:Strings.Main_PauseAll}" Command="{Binding DownloadManager.PauseAllCommand}" />
                            <Button Content="{x:Static res:Strings.Main_ResumeAll}" Command="{Binding DownloadManager.ResumeAllCommand}" />
                            <Button Content="{x:Static res:Strings.Main_ClearCompleted}" Command="{Binding DownloadManager.ClearCompletedCommand}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding DownloadManager.Downloads}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:DownloadEntryViewModel">
                                    <Grid Margin="6,2" ColumnDefinitions="*,90,140,80,Auto">
                                        <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding Status}" />
                                        <TextBlock Grid.Column="2" Text="{Binding ProgressText}" />
                                        <TextBlock Grid.Column="3" Text="{Binding SpeedText}" />
                                        <Button Grid.Column="4" Content="{x:Static res:Strings.Common_Cancel}" Classes="small"
                                                Command="{Binding CancelCommand}" IsVisible="{Binding CanPause}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </Grid>
    </DockPanel>
</UserControl>
