<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- RomManager's look, shared by App.axaml and the headless UI tests. -->
    <!-- Font fallback chain: Latin, Japanese, Korean, Chinese, then broad Unicode -->
    <Style Selector=":is(TextBlock)">
        <Setter Property="FontFamily"
                Value="Segoe UI, Yu Gothic UI, Malgun Gothic, Microsoft YaHei UI, Tahoma, Arial Unicode MS" />
    </Style>
    <Style Selector="TextBox">
        <Setter Property="FontFamily"
                Value="Segoe UI, Yu Gothic UI, Malgun Gothic, Microsoft YaHei UI, Tahoma, Arial Unicode MS" />
    </Style>

    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector=":is(TextBlock).h3">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector=":is(TextBlock).muted">
        <Setter Property="Opacity" Value="0.65" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="TextBlock.section">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,10,0,4" />
    </Style>
    <Style Selector="TextBlock.warning">
        <Setter Property="Foreground" Value="#C98500" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="SelectableTextBlock.mono">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style Selector="Button.small">
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- A text that acts as a link (related games, copy). -->
    <Style Selector="Button.link">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource SystemAccentColor}" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.copy">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Opacity" Value="0.55" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style Selector="StackPanel.toolbar">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="4" />
        <Setter Property="Margin" Value="4" />
    </Style>
    <Style Selector="StackPanel.toolbar > Button">
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style Selector="Border.statusbar">
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="BorderBrush" Value="{DynamicResource SystemControlForegroundBaseLowBrush}" />
    </Style>
    <Style Selector="Border.banner">
        <Setter Property="Background" Value="#33FFB400" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="8,6,8,0" />
    </Style>

    <Style Selector="Border.stat">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Margin" Value="0,0,10,10" />
        <Setter Property="MinWidth" Value="130" />
    </Style>
    <Style Selector="TextBlock.stat-value">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.stat-label">
        <Setter Property="Opacity" Value="0.65" />
    </Style>

    <Style Selector="Button.tile">
        <Setter Property="Width" Value="230" />
        <Setter Property="MinHeight" Value="110" />
        <Setter Property="Margin" Value="0,0,10,10" />
        <Setter Property="Padding" Value="14,10" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>

    <Style Selector="Button.card">
        <Setter Property="Padding" Value="8" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Border.cover">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="TextBlock.initials">
        <Setter Property="FontSize" Value="32" />
        <Setter Property="Opacity" Value="0.4" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="ListBox.sidebar">
        <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundBaseLowBrush}" />
    </Style>
    <Style Selector="ListBox.sidebar ListBoxItem">
        <Setter Property="Padding" Value="12,7" />
    </Style>

    <Style Selector="ListBox.log ListBoxItem">
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style Selector="ListBox.log SelectableTextBlock">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, monospace" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <Style Selector="TabControl.panel TabItem">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinHeight" Value="30" />
        <Setter Property="Padding" Value="10,0" />
    </Style>
</Styles>
