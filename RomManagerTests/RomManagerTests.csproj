<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Avalonia.Skia" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RomManagerShared\RomManagerShared.csproj" />
    <!-- Every console module, so tests can use their types directly. -->
    <ProjectReference Include="..\Consoles\*\*.csproj" />
    <ProjectReference Include="..\AvaloniaApplication1\AvaloniaUI\AvaloniaUI.csproj" />
    <!-- Built so PluginManagerTests can load the real sample plugin; not referenced at compile time. -->
    <ProjectReference Include="..\SamplePlugin\SamplePlugin.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
