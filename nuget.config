<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- Fallback for packages that may leave nuget.org (Ryujinx.LibHac is unlisted). Filled by
         tools/pin-packages.ps1; the .nupkg files are git-ignored. -->
    <add key="local" value="nuget-local" />
  </packageSources>
</configuration>
