<Project Sdk="Microsoft.NET.Sdk">
  <!-- The plugin contract and the rom model. Plugins reference only this; RomManagerShared forwards the
       types here so library data and plugins built against RomManagerShared keep working. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RomManagerShared</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="RomManagerShared" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
</Project>
