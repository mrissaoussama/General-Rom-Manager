<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateRuntimeConfigurationFiles>True</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CHDSharp" />
    <PackageReference Include="Ryujinx.LibHac" />
    <ProjectReference Include="..\SkyEditor.IO\SkyEditor.IO.csproj" />
  </ItemGroup>
	<ItemGroup>
		<None Update="Utils\PKGUtils\PARAM.SFO.dll">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
		<None Update="PS4\PS4_Tools.dll">
		  <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>
	<ItemGroup>
		<PackageReference Include="LTRData.DiscUtils.Iso9660" />
		<PackageReference Include="LTRData.DiscUtils.Udf" />
		<PackageReference Include="HtmlAgilityPack" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Design">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Proxies" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
		<PackageReference Include="Microsoft.Extensions.Configuration.Json" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
		<PackageReference Include="Microsoft.Extensions.Hosting" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
		<PackageReference Include="SkyEditor.Utilities.AsyncFor" />
		<PackageReference Include="Syroot.BinaryData" />
		<!-- System.Drawing.Common required by Xbox/ISO2GOD parsers; Windows-only -->
		<PackageReference Include="System.Drawing.Common" />
		<PackageReference Include="System.IO.Hashing" />
	</ItemGroup>
	<ItemGroup>
	  <Reference Include="PARAM.SFO">
	    <HintPath>PS4\PARAM.SFO.dll</HintPath>
	  </Reference>
	  <Reference Include="PS4_Tools">
	    <HintPath>PS4\PS4_Tools.dll</HintPath>
	  </Reference>
	</ItemGroup>
</Project>
