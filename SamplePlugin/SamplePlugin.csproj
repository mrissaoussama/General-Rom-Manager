<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SamplePlugin</AssemblyName>
    <!-- Shipped with the app: the desktop head copies the build output to BuiltInPlugins/SamplePlugin/. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- The plugin contract and rom model; RomManager supplies the assembly at runtime, so it is not copied. -->
    <ProjectReference Include="..\RomManager.Abstractions\RomManager.Abstractions.csproj" Private="false" />
  </ItemGroup>

</Project>
