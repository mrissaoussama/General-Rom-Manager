{
  "$schema": "http://json.schemastore.org/template",
  "author": "RomManager",
  "classifications": [ "RomManager", "Plugin", "Library" ],
  "identity": "RomManager.Plugin.Template",
  "name": "RomManager plugin",
  "shortName": "rommanager-plugin",
  "description": "A RomManager plugin: one context-menu action and a scan hook.",
  "sourceName": "MyPlugin",
  "preferNameDirectory": true,
  "tags": { "language": "C#", "type": "project" },
  "symbols": {
    "RomManagerShared": {
      "type": "parameter",
      "datatype": "string",
      "description": "Path to RomManagerShared.csproj in your RomManager checkout.",
      "defaultValue": "../RomManager/RomManagerShared/RomManagerShared.csproj",
      "replaces": "ROMMANAGER_SHARED_PATH"
    },
    "Author": {
      "type": "parameter",
      "datatype": "string",
      "defaultValue": "Your Name",
      "replaces": "PLUGIN_AUTHOR"
    }
  }
}
