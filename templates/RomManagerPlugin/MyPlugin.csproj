<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Only the plugin's own files land in bin/: the host's libraries come from RomManager at runtime. -->
    <DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile against the host; never ship it: RomManager provides it at runtime. -->
    <ProjectReference Include="ROMMANAGER_SHARED_PATH" Private="false" ExcludeAssets="runtime" />
  </ItemGroup>

</Project>
